    "@types/node": "^22.5.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  }

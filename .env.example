# apps/api/.env
DATABASE_URL="file:./dev.db"
# For production Postgres: DATABASE_URL="postgresql://user:password@localhost:5432/reactcode"
# (also change the `provider` in prisma/schema.prisma from "sqlite" to "postgresql")
JWT_SECRET="change-me-to-a-long-random-value"
WEB_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
EXECUTION_SERVICE_URL=local
